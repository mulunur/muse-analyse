# Muse Analyse — Примеры конфигурации

# ===== LLM Provider Selection =====
# Выберите провайдер: openai, claude, ollama, nemotron
LLM_PROVIDER=openai

# ===== OpenAI Configuration =====
# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ===== Anthropic Claude Configuration =====
# Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Актуальные: claude-sonnet-5 (по умолчанию), claude-opus-5, claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-5

# ===== Ollama Configuration (локальный запуск) =====
# Установка: https://ollama.ai/download
# Запуск: ollama serve
# Модели: ollama pull mistral, ollama pull llama2, ollama pull neural-chat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ===== NVIDIA Nemotron Configuration =====
# Получить ключ: https://docs.nvidia.com/cloud/cloud-docs/getting-started/quickstart.html
NEMOTRON_API_KEY=nvapi_your_api_key_here
NEMOTRON_MODEL=meta/llama-2-70b-chat
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# ===== LLM Response Settings =====
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ===== Upload Configuration =====
MAX_UPLOAD_SIZE_MB=50

# ===== Server Configuration =====
HOST=0.0.0.0
PORT=8000

# ===== RAG Configuration =====
# Включить поиск по учебникам при генерации обзоров
RAG_ENABLED=true
# Каталог с PDF-учебниками и каталог индекса
KNOWLEDGE_DIR=data/knowledge
RAG_INDEX_DIR=data/rag_index
# Мультиязычная модель (поддерживает русский)
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Количество фрагментов для контекста LLM
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# ===== Очередь задач (Celery + Redis) =====
# Анализ трека и шаги Growth Copilot выполняются в отдельном процессе-воркере
# (см. docker-compose.yml — сервисы redis и worker), а не внутри веб-процесса.
# Обычный Redis — только брокер и хранилище результатов задач.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Сколько хранить результат задачи после завершения, пока фронтенд не забрал.
CELERY_RESULT_EXPIRES_SECONDS=3600

# Состояние Growth Copilot между /api/growth/start и /api/growth/select —
# эти запросы могут обрабатываться разными воркерами, поэтому не может жить
# только в памяти одного процесса. Файл SQLite на общем томе (см. volume
# growth_state в docker-compose.yml).
GROWTH_CHECKPOINT_DB_PATH=data/growth/checkpoints.sqlite3

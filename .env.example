# Muse Analyse: configuration examples

# ===== LLM Provider Selection =====
# Pick a provider: openai, claude, ollama, nemotron
LLM_PROVIDER=openai

# ===== OpenAI Configuration =====
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ===== Anthropic Claude Configuration =====
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Current models: claude-sonnet-5 (default), claude-opus-5, claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-5

# ===== Ollama Configuration (runs locally) =====
# Install it: https://ollama.ai/download
# Start it with: ollama serve
# Models: ollama pull mistral, ollama pull llama2, ollama pull neural-chat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ===== NVIDIA Nemotron Configuration =====
# Get a key: https://docs.nvidia.com/cloud/cloud-docs/getting-started/quickstart.html
NEMOTRON_API_KEY=nvapi_your_api_key_here
NEMOTRON_MODEL=meta/llama-2-70b-chat
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# ===== LLM Response Settings =====
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ===== Upload Configuration =====
MAX_UPLOAD_SIZE_MB=50

# ===== Server Configuration =====
HOST=0.0.0.0
PORT=8000

# ===== RAG Configuration =====
# Turn on searching the textbooks when reviews are generated
RAG_ENABLED=true
# The directory with the PDF textbooks, and the directory for the index
KNOWLEDGE_DIR=data/knowledge
RAG_INDEX_DIR=data/rag_index
# A multilingual model (it supports Russian)
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# How many passages to give the LLM as context
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# ===== Task queue (Celery + Redis) =====
# Track analysis and the Growth Copilot steps run in a separate worker process
# (see docker-compose.yml: the redis and worker services), not inside the web process.
# Plain Redis is used only as a broker and a place to store task results.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# How long to keep a task result after it finishes, so the frontend has time to pick it up.
CELERY_RESULT_EXPIRES_SECONDS=3600

# Growth Copilot state between /api/growth/start and /api/growth/select.
# These requests can be handled by different workers, so the state cannot live
# only in the memory of a single process. It is a SQLite file on a shared volume
# (see the growth_state volume in docker-compose.yml).
GROWTH_CHECKPOINT_DB_PATH=data/growth/checkpoints.sqlite3
